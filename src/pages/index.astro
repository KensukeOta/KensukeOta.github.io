---
import { getCollection } from "astro:content";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import Hero from "../components/home/Hero.astro";
import ProfileSummary from "../components/home/ProfileSummary.astro";
import Skills from "../components/home/Skills.astro";
import Layout from "../layouts/Layout.astro";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Layout
  title="Portfolio | Ota Kensuke"
  description="Webアプリケーション開発とデータ分析に取り組むエンジニアのポートフォリオです。"
>
  <Hero />
  <FeaturedProjects projects={projects} />
  <Skills />
  <ProfileSummary />
</Layout>
