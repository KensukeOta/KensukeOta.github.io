---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ProjectHero from "../../components/projects/ProjectHero.astro";
import ProjectNote from "../../components/projects/ProjectNote.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout
  title={`${project.data.title} | Ota Kensuke`}
  description={project.data.summary}
>
  <ProjectHero project={project} />
  <section class="py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[1fr_17rem]">
        <article class="project-content max-w-2xl">
          <Content />
        </article>
        <ProjectNote
          description={project.data.projectNote}
          appUrl={project.data.demo}
          githubUrl={project.data.github}
        />
      </div>
    </div>
  </section>
</Layout>
