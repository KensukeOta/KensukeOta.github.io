---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ProjectHero from "../../components/projects/ProjectHero.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");

	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} | Your Name`} description={project.data.summary}>
	<ProjectHero project={project} />
	<section class="py-14 sm:py-16">
		<div class="mx-auto max-w-5xl px-6 lg:px-8">
			<div class="grid gap-12 lg:grid-cols-[1fr_17rem]">
				<article class="project-content max-w-2xl">
					<Content />
				</article>
				<aside class="h-fit rounded-xl border border-slate-200 bg-white p-6 lg:sticky lg:top-8">
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
						Project Note
					</p>
					<p class="mt-4 text-sm leading-7 text-slate-600">
						現在は掲載内容のサンプルです。実際の成果物に合わせ、画像、数値、公開リンクを差し替えて使用できます。
					</p>
					<a
						href="/projects"
						class="mt-7 inline-flex text-sm font-semibold text-blue-700 hover:text-blue-800"
					>
						作品一覧へ戻る
					</a>
				</aside>
			</div>
		</div>
	</section>
</Layout>
