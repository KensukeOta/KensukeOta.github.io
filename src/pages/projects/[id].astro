---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ProjectHero from "../../components/projects/ProjectHero.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout
  title={`${project.data.title} | Ota Kensuke`}
  description={project.data.summary}
>
  <ProjectHero project={project} />
  <section class="py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[1fr_17rem]">
        <article class="project-content max-w-2xl">
          <Content />
        </article>
        <aside
          class="h-fit rounded-xl border border-slate-200 bg-white p-6 lg:sticky lg:top-8"
        >
          <p
            class="text-xs font-semibold tracking-[0.18em] text-slate-500 uppercase"
          >
            Project Note
          </p>

          <p class="mt-4 text-sm leading-7 text-slate-600">
            CSVアップロードのみで、 EDA・可視化・AI要約を行える
            非エンジニア向け分析ツールとして開発。 AIフォールバック設計や
            テスト・CI/CDも実装し、 実務を意識した開発を行いました。
          </p>

          <!-- Demo / GitHub -->
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="https://insight-report-ai-kensuke.vercel.app/"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-800"
            >
              Live Demo
            </a>

            <a
              href="https://github.com/KensukeOta/Insight-Report-AI"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50"
            >
              GitHub
            </a>
          </div>

          <a
            href="/projects"
            class="mt-7 inline-flex text-sm font-semibold text-blue-700 hover:text-blue-800"
          >
            作品一覧へ戻る
          </a>
        </aside>
      </div>
    </div>
  </section>
</Layout>
