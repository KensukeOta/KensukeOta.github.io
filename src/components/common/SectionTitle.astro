---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-2xl">
  {
    eyebrow && (
      <p class="mb-3 text-xs font-semibold tracking-[0.2em] text-blue-700 uppercase">
        {eyebrow}
      </p>
    )
  }
  <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
    {title}
  </h2>
  {description && <p class="mt-4 leading-8 text-slate-600">{description}</p>}
</div>
