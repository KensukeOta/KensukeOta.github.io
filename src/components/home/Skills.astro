---
import SectionTitle from "../common/SectionTitle.astro";
import Tag from "../common/Tag.astro";

const skillGroups = [
	{
		title: "Frontend",
		description: "閲覧者が目的へ迷わず到達できるUIを設計・実装します。",
		skills: ["Astro", "Svelte", "TypeScript", "Tailwind CSS"],
	},
	{
		title: "Data & Machine Learning",
		description: "データの整備から分析、モデル評価、可視化まで取り組みます。",
		skills: ["Python", "pandas", "scikit-learn", "Matplotlib"],
	},
	{
		title: "Development",
		description: "公開と改善を意識し、再現しやすい開発を進めます。",
		skills: ["Git", "GitHub", "Vercel", "SQL"],
	},
];
---

<section id="skills" class="border-y border-slate-200 bg-white py-16 sm:py-20">
	<div class="mx-auto max-w-6xl px-6 lg:px-8">
		<SectionTitle
			eyebrow="Skills"
			title="扱える技術領域"
			description="制作物で活用している技術を領域別に整理しています。"
		/>
		<div class="mt-12 grid gap-6 lg:grid-cols-3">
			{
				skillGroups.map((group) => (
					<div class="rounded-xl border border-slate-200 p-7">
						<h3 class="text-lg font-bold text-slate-900">{group.title}</h3>
						<p class="mt-3 min-h-14 text-sm leading-7 text-slate-600">{group.description}</p>
						<div class="mt-6 flex flex-wrap gap-2">
							{group.skills.map((skill) => <Tag>{skill}</Tag>)}
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
